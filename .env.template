# Solo NOMBRES de variables, sin valores.
# Los valores reales los carga Daniel en un archivo .env local (no se commitea).
# Los nombres son propios de la app mobile; en el portal equivalen a las variables NEXT_PUBLIC_*.

# URL base de la API (la misma que usa el portal)
API_URL=

# Usuario de servicio de la API (el portal lo usa para pedir el token en api/Usuarios/login)
API_SERVICE_EMAIL=
API_SERVICE_PASSWORD=

# Configuración del proyecto Firebase (mismo proyecto que el portal)
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
