# Solo NOMBRES de variables, sin valores.
# Los valores reales los carga Daniel en un archivo .env local (no se commitea).
# Los nombres son propios de la app mobile; en el portal equivalen a las variables NEXT_PUBLIC_*.
# Después de crear o cambiar el .env, reiniciar Metro con --reset-cache.

# URL base de la API (la misma que usa el portal)
API_URL=

# Usuario de servicio de la API (el portal lo usa para pedir el token en api/Usuarios/login)
API_SERVICE_EMAIL=
API_SERVICE_PASSWORD=

# Opcional: tenant (ID o dominio) de Microsoft Entra para restringir el login con Microsoft a la cuenta de Austral.
# Si queda vacío, el login no restringe el tenant.
MICROSOFT_TENANT=

# Opcional: URL del Portal Evaluación CAE (en el portal es NEXT_PUBLIC_PORTAL_CAE_URL).
# Es el destino del botón "Ir" de la notificación "Postulaciones de promoción para revisión".
# Si queda vacío, esa notificación lleva a Docencia, igual que el portal cuando la variable está vacía.
PORTAL_CAE_URL=

# La configuración de Firebase NO va acá: con React Native Firebase sale de los archivos nativos
# google-services.json (Android) y GoogleService-Info.plist (iOS). Ambos están en .gitignore.
